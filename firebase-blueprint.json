{
  "entities": {
    "Team": {
      "title": "Team",
      "description": "Equipo de fútbol amateur",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": { "type": "string", "minLength": 2, "maxLength": 50 },
        "primaryColor": { "type": "string", "minLength": 4, "maxLength": 20 },
        "secondaryColor": { "type": "string", "minLength": 4, "maxLength": 20 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "primaryColor"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Torneo o campeonato del equipo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "year": { "type": "string", "maxLength": 10 },
        "description": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teamId", "name"]
    },
    "Player": {
      "title": "Player",
      "description": "Jugador del equipo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "jerseyNumber": { "type": "number" },
        "phone": { "type": "string", "minLength": 7, "maxLength": 20 },
        "idCard": { "type": "string", "maxLength": 30 },
        "eps": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Activo", "Inactivo", "Lesionado"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teamId", "fullName", "jerseyNumber", "phone", "status"]
    },
    "Concept": {
      "title": "Concept",
      "description": "Concepto de cobro frecuente o valor de arbitraje por defecto",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "suggestedValue": { "type": "number" },
        "isDefaultArbitration": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teamId", "name", "suggestedValue"]
    },
    "Match": {
      "title": "Match",
      "description": "Partido programado con convocatoria de jugadores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "tournamentId": { "type": "string" },
        "tournamentName": { "type": "string", "maxLength": 100 },
        "rival": { "type": "string", "minLength": 2, "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "time": { "type": "string", "maxLength": 20 },
        "location": { "type": "string", "maxLength": 150 },
        "refereeFee": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Abierta", "Cerrada"] },
        "callups": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teamId", "rival", "date", "status"]
    }
  },
  "firestore": {
    "/teams/{teamId}": {
      "schema": { "$ref": "#/entities/Team" },
      "description": "Colección de equipos de fútbol"
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Colección de torneos"
    },
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Colección de jugadores registrados"
    },
    "/concepts/{conceptId}": {
      "schema": { "$ref": "#/entities/Concept" },
      "description": "Colección de conceptos de cobro y arbitraje"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Colección de partidos y convocatorias"
    }
  }
}
